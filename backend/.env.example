# --- Model orchestrator (external service -- we do not host models here) ---
MODEL_ORCH_BASE_URL=http://192.168.0.99:9900
MODEL_ORCH_API_KEY=model-orch-dev-token
MODEL_ORCH_CHAT_MODEL=Qwen3.8-27B
MODEL_ORCH_EMBED_MODEL=bge-m3
# Keep false until streaming is fixed upstream -- stream=true hangs
# indefinitely today (confirmed: 90s+, zero bytes). See settings.py.
MODEL_ORCH_STREAMING_ENABLED=false
MODEL_ORCH_TIMEOUT_SECONDS=180
# Confirmed live: the deployed chat model's context window is 16384 tokens
# TOTAL (input + output). The agent loop trims history to fit before every
# call -- see llm/token_budget.py. Only raise this once you've confirmed the
# deployed model's actual window is larger.
MODEL_ORCH_CONTEXT_WINDOW_TOKENS=16384
MODEL_ORCH_REPLY_MAX_TOKENS=1024

# --- This service's own listening socket ---
# 0.0.0.0 so it's reachable from other machines, not just loopback.
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8765

# --- Logging ---
LOG_LEVEL=INFO

# --- Workspace retrieval index cache ---
INDEX_CACHE_DIR=~/.cache/coding-assistant/index

# --- Chat persistence (Redis) ---
REDIS_URL=redis://localhost:6336/0
